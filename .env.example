# ── Local Ollama only. Override for your company deployment. ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6
OLLAMA_NUM_CTX=8192

# ── Output & logging ──
OUTPUT_DIR=./output
LOG_LEVEL=INFO

# ── Pipeline defaults (optional) ──
DPBA_DEFAULT_CATALOG=main
DPBA_DEFAULT_SCHEMA=default
DPBA_DEFAULT_ENV=dev

# ── LLM retry settings ──
DPBA_LLM_MAX_RETRIES=2
DPBA_LLM_TIMEOUT=300
DPBA_LLM_MAX_OUTPUT_TOKENS=4096

# ── Enable live Ollama integration tests (pytest) ──
# DPBA_LLM_INTEGRATION_TESTS=1
